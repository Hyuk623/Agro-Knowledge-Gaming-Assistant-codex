    "sunlight_level": {
      "low": { "lightScore": -6, "growthScore": -2 },
      "normal": { "lightScore": 1, "growthScore": 1 },
      "high": { "lightScore": 4, "growthScore": 2 }
    },
    "disease_pressure_level": {
      "low": { "diseaseRisk": -4 },
      "normal": { "diseaseRisk": 2 },
      "high": { "diseaseRisk": 7 }
    }
  },
  "disease_rules": {
    "high_irrigation_low_ventilation": 10,
    "low_sunlight_low_ventilation": 7,
    "stress_streak_multiplier": 2,
    "stress_trigger_threshold": 2
