    "heating": {
      "low": { "growthScore": -4, "costScore": 2 },
      "normal": { "growthScore": 2, "costScore": -3 },
      "high": { "growthScore": 5, "costScore": -8 }
    },
    "ventilation": {
      "low": { "diseaseRisk": 5, "growthScore": 1 },
      "normal": { "diseaseRisk": -2, "growthScore": 0 },
      "high": { "diseaseRisk": -6, "growthScore": -1 }
